@using BaiTapThucTapFrontend.Models
@using BaiTapThucTapFrontend.Services
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject AppState AppState
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark px-3 px-lg-4 shadow navbar-custom">

        <!-- LOGO -->
        <a class="navbar-brand fw-bold text-white" href="/wms">
            WMS
        </a>

        <!-- TOGGLE -->
        <button class="navbar-toggler border-0 shadow-none"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

            <i class="bi bi-list text-white fs-2"></i>

        </button>

        <!-- MENU -->
        <div class="collapse navbar-collapse" id="navbarNav">

            <!-- LEFT MENU -->
            <ul class="navbar-nav me-auto">

                @if (AppState.isAdmin == true)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link text-white"
                                 href="don-vi-tinh">
                            Đơn Vị Tính
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link text-white"
                                 href="loai-san-pham">
                            Loại Sản Phẩm
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link text-white"
                                 href="san-pham">
                            Sản Phẩm
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link text-white"
                                 href="nha-cung-cap">
                            Nhà Cung Cấp
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link text-white"
                                 href="kho">
                            Kho
                        </NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link text-white"
                                 href="kho-user">
                            Tài Khoản
                        </NavLink>
                    </li>
                }

                <li class="nav-item">
                    <NavLink class="nav-link text-white"
                             href="nhap-kho">
                        Nhập Kho
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white"
                             href="bao-cao-chi-tiet-hang-nhap">
                        Báo Cáo Nhập
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white"
                             href="xuat-kho">
                        Xuất Kho
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white"
                             href="bao-cao-chi-tiet-hang-xuat">
                        Báo Cáo Xuất
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link text-white"
                             href="bao-cao-xuat-nhap-ton">
                        Xuất Nhập Tồn
                    </NavLink>
                </li>

            </ul>

            <!-- USER -->
            <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0 user-box">

                <img src="https://cdn.pixabay.com/photo/2023/02/18/11/00/icon-7797704_640.png"
                     width="38"
                     height="38"
                     class="rounded-circle border border-light flex-shrink-0" />

                <span class="text-white fw-semibold text-truncate user-name">
                    @AppState.Ma_Dang_Nhap
                </span>

                <button class="btn btn-light btn-sm rounded-pill px-3"
                        @onclick="Logout">

                    <i class="bi bi-box-arrow-right"></i>

                </button>

            </div>

        </div>
    </nav>

    <!-- CONTENT -->
    <div class="container-fluid px-3 px-lg-4 mt-4">
        @Body
    </div>

</div>

@code {

    protected override void OnInitialized()
    {
        AppState.OnChange += Refresh;
    }

    void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnChange -= Refresh;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine("User: " + AppState.Ma_Dang_Nhap);
    }

    public async Task Logout()
    {
        // clear AppState
        AppState.Ma_Dang_Nhap = "";
        AppState.isAdmin = false;
        AppState.Kho_ID = 0;

        AppState.Notify();

        // clear localStorage
        await JS.InvokeVoidAsync("localStorage.removeItem", "maDangNhap");
        await JS.InvokeVoidAsync("localStorage.removeItem", "khoId");

        // redirect login
        Navigation.NavigateTo("/", true);
    }
}