@code {

    protected override void OnInitialized()
    {
        AppState.OnChange += Refresh;
    }

    void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnChange -= Refresh;
    }


        protected override void OnAfterRender(bool firstRender)
        {
            Console.WriteLine("User: " + AppState.Ma_Dang_Nhap);
        }
  

    async Task Logout()
    {
        // clear AppState (RAM)
        AppState.Ma_Dang_Nhap = "";
        AppState.isAdmin = false;
        AppState.Kho_ID = 0;

        AppState.Notify();

        // clear localStorage (nếu có dùng)
        await JS.InvokeVoidAsync("localStorage.removeItem", "maDangNhap");
        await JS.InvokeVoidAsync("localStorage.removeItem", "khoId");

        // chuyển về login
        Navigation.NavigateTo("/");
    }
}
