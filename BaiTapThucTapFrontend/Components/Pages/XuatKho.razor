    //     new NhapKhoDto{Id = 4,So_Phieu_Nhap_Kho = "004",Kho_ID = 4, NCC_ID = 4,Ngay_Nhap_Kho = new DateTime(2026,1,4), Ghi_Chu = "Note", Details = new List<NhapKhoDetailDto> { new NhapKhoDetailDto {Id = 4, Nhap_Kho_ID = 4, San_Pham_ID = 4, SL_Nhap = 3, Don_Gia_Nhap = 0m } } },
    //     new NhapKhoDto{Id = 5,So_Phieu_Nhap_Kho = "005",Kho_ID = 5, NCC_ID = 5,Ngay_Nhap_Kho = new DateTime(2026,1,5), Ghi_Chu = "Note", Details = new List<NhapKhoDetailDto> { new NhapKhoDetailDto {Id = 5, Nhap_Kho_ID = 5, San_Pham_ID = 5, SL_Nhap = 4, Don_Gia_Nhap = 0m } } },
    // };

    private XuatKhoDto model = new();
    private bool showForm = false;
    private string msg = "";

    private bool isEdit = false;
    private bool isEditDetailForm = false;
    private bool isEditHeaderForm = false;

    // chi tiet

    private List<XuatKhoDetailDto> chiTietList = new();
    private List<SanPhamDto>? listSanPham = new();

    private void AddCT()
    {
        chiTietList.Add(new XuatKhoDetailDto());
    }

    private void RemoveCT(XuatKhoDetailDto ct)
    {
        chiTietList.Remove(ct);
    }

    private void EnableEditDetail()
    {
        isEditDetailForm = true;
    }
    private void EnableEditHeader()
    {
        isEditHeaderForm = true;
    }
    private string GetTenSP(int id)
    {
        return listSanPham.FirstOrDefault(x => x.Id == id)?.Ten_San_Pham ?? "";
    }
    //

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
        await LoadDropdown();
        isEditDetailForm = false;
        isEditHeaderForm = false;
        model.ChiTiets = chiTietList;
    }

    private async Task LoadList()
    {
        try
        {
            listData = await Http.GetFromJsonAsync<List<XuatKhoDto>>("api/XuatKho");
        }
        catch
        {
            msg = "Lỗi khi lấy thông tin xuất kho";
        }
    }

    private async Task LoadDropdown()
    {
        try
        {
            listKho = await Http.GetFromJsonAsync<List<KhoDto>>("api/Kho");
            listSanPham = await Http.GetFromJsonAsync<List<SanPhamDto>>("api/SanPham");
        }
        catch
        {
            msg = "Lỗi không lấy được dữ liệu kho hoặc sản phẩm";
        }
    }
    // reset data model when add nhapkho
    void ResetForm()
    {
        model = new XuatKhoDto();
        chiTietList = new List<XuatKhoDetailDto>();
        isEdit = false;
        msg = "";
    }

    void OpenAddForm()
    {
        ResetForm();
        showForm = true;
    }
    //-------------
    private async Task HandleSave()
    {
        if (string.IsNullOrEmpty(model.So_Phieu_Xuat_Kho))
        {
            msg = "Vui lòng nhập số phiếu xuất kho!";
            return;
        }

        if (model.Kho_ID <= 0)
        {
            msg = "Kho không hợp lệ";
            return;
        }

        if (model.Ngay_Xuat_Kho == null)
        {
            msg = "Vui lòng chọn ngày xuất kho";
            return;
        }

        if (chiTietList.Count == 0)
        {
            msg = "Phải có ít nhất 1 sản phẩm!";
            return;
        }

        model.ChiTiets = chiTietList;

        if (isEdit)
        {

            try
            {
                await Http.PutAsJsonAsync($"api/XuatKho/{model.Id}", model);
                msg = "Cập nhật thành công!";
            }
            catch
            {
                msg = "Lỗi khi cập nhật xuất kho";
            }
        }
        else
        {
            try
            {
                var res = await Http.PostAsJsonAsync("api/XuatKho", model);
                if (res.IsSuccessStatusCode) msg = "Thêm mới thành công!";
                else
                {
                    var error = await res.Content.ReadAsStringAsync();
                    msg = error;
                }
            }
            catch
            {
                msg = "Lỗi khi thêm phiếu xuất kho";
            }
        }

        model = new();
        isEdit = false;
        await LoadList();
    }

    private async Task HandleSaveHeader()
    {
        if (string.IsNullOrEmpty(model.So_Phieu_Xuat_Kho))
        {
            msg = "Vui lòng nhập số phiếu xuất kho!";
            return;
        }

        if (model.Kho_ID <= 0)
        {
            msg = "Kho không hợp lệ";
            return;
        }

        if (model.Ngay_Xuat_Kho == null)
        {
            msg = "Vui lòng chọn ngày xuất kho";
            return;
        }

        if (chiTietList.Count == 0)
        {
            msg = "Phải có ít nhất 1 sản phẩm!";
            return;
        }

        model.ChiTiets = chiTietList;


        try
        {
            var res = await Http.PostAsJsonAsync("api/XNKXuatKho/adjustment", model);
            if (res.IsSuccessStatusCode) msg = "Cập nhật thành công!";
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                msg = error;
            }
        }
        catch
        {
            msg = "Lỗi khi cập nhật phiếu xuất kho";
        }

        model = new();
        isEdit = false;
        await LoadList();
    }

    private async Task HandleSaveDetail()
    {
        if (chiTietList.Count == 0)
        {
            msg = "Phải có ít nhất 1 sản phẩm!";
            return;
        }

        model.ChiTiets = chiTietList;
        var headerId = model.Id;
        try
        {
            var res = await Http.PostAsJsonAsync("api/XNKXuatKho/adjustment/{headerId}", model);
            if (res.IsSuccessStatusCode) msg = "Cập nhật thành công!";
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                msg = error;
            }
        }
        catch
        {
            msg = "Lỗi khi cập nhật phiếu xuất kho";
        }

        model = new();
        isEdit = false;
        await LoadList();
    }

    private void LoadEditHeader(XuatKhoDto item)
    {
        model = new XuatKhoDto { Id = item.Id, So_Phieu_Xuat_Kho = item.So_Phieu_Xuat_Kho, Kho_ID = item.Kho_ID, Ngay_Xuat_Kho = item.Ngay_Xuat_Kho, Ghi_Chu = item.Ghi_Chu };
        chiTietList = item.ChiTiets?.ToList() ?? new List<XuatKhoDetailDto>();

        isEdit = true;
        isEditHeaderForm = true;
        //isEditDetailMode = false; // đang edit header
        msg = "Đang ở chế độ chỉnh sửa.";
    }

    private void LoadEditDetail(XuatKhoDto item)
    {
        model = new XuatKhoDto { Id = item.Id, So_Phieu_Xuat_Kho = item.So_Phieu_Xuat_Kho, Kho_ID = item.Kho_ID, Ngay_Xuat_Kho = item.Ngay_Xuat_Kho, Ghi_Chu = item.Ghi_Chu };
        chiTietList = item.ChiTiets?.ToList() ?? new List<XuatKhoDetailDto>();

        isEdit = true;
        isEditDetailForm = true;
        //isEditDetailMode = false; // đang edit header
        msg = "Đang ở chế độ chỉnh sửa.";
    }

    private async Task Delete(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn xóa phiếu xuất này?");
        if (confirm)
        {
            try
            {
                await Http.DeleteAsync($"api/XuatKho/{id}");
                await LoadList();
            }
            catch
            {
                msg = "Lỗi khi xoá xuất kho";
            }
        }
    }
}