                        </div>

                        <div class="col-md-3">
                            <label>Kho</label>
                            <select class="form-select"
                                    @bind="model.Kho_ID">
                                <option value="">-- chọn kho --</option>
                                @foreach (var kho in listKho)
                                {
                                    <option value="@kho.Id">@kho.Ten_Kho</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label>Ngày nhập</label>
                            <InputDate @bind-Value="model.Ngay_Xuat_Kho"
                                       class="form-control" />
                        </div>

                        <div class="col-md-12">
                            <label>Ghi chú</label>
                            <input class="form-control"
                                   @bind="model.Ghi_Chu" />
                        </div>

                    </div>
                    <hr />

                    <!-- DETAIL -->
                   @*  <button class="btn btn-warning"
                            @onclick="EnableEditDetail">
                        ✏️ Sửa chi tiết
                    </button> *@
                    <div class="d-flex justify-content-between mb-2">
                        <h5>Chi tiết sản phẩm</h5>
                        <button class="btn btn-sm text-white"
                                style="background:#6f42c1"
                                @onclick="AddCT">
                            + Thêm dòng
                        </button>
                    </div>

                    <table class="table table-striped table-hover table-purple">
                        <thead class="text-center">
                            <tr>
                                <td style="width:30%">Sản phẩm</td>
                                <td>Số lượng</td>
                                <td>Đơn giá</td>
                                <td>Trị giá</td>
                                <td width="80"></td>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in chiTietList)
                            {
                                <tr>
                                    <td>
                                        @if (ct.Id == 0) // thêm mới
                                        {
                                            <select class="form-select" @bind="ct.San_Pham_ID">
                                                <option value="">-- chọn --</option>
                                                @foreach (var sp in listSanPham)
                                                {
                                                    <option value="@sp.Id">@sp.Ten_San_Pham</option>
                                                }
                                            </select>
                                        }
                                        else // edit
                                        {
                                            <input class="form-control"
                                                   value="@GetTenSP(ct.San_Pham_ID)"
                                                   disabled />
                                        }
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control text-end"
                                               @bind="ct.SL_Xuat" />
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control text-end"
                                               @bind="ct.Don_Gia_Xuat" />
                                    </td>

                                    <td class="text-end">
                                        @(ct.SL_Xuat * ct.Don_Gia_Xuat)
                                    </td>

                                    <td class="text-center">
                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => RemoveCT(ct)">
                                            X
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- TOTAL -->
                    <div class="text-end fw-bold">
                        Tổng tiền:
                        @chiTietList.Sum(x => x.SL_Xuat * x.Don_Gia_Xuat)
                    </div>

                    <hr />

                    <!-- FOOTER -->
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-danger"
                                @onclick="() => showForm = false">
                            Hủy
                        </button>

                        <button class="btn text-white"
                                style="background:#6f42c1"
                                @onclick="HandleSave">
                            💾 Lưu
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(msg))
                    {
                        <div class="alert alert-info mt-2">@msg</div>
                    }
                </div>
            </div>
        </div>
    }

