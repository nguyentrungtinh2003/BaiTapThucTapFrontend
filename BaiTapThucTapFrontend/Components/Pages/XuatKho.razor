                                    </button>

                                    <button class="btn btn-sm btn-warning"
                                            title="Sửa chi tiết"
                                            @onclick="() => LoadEditDetail(item)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button class="btn btn-sm text-white" style="background:#6f42c1"
