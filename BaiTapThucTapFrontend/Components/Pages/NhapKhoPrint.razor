@page "/nhap-kho-print/{Id:int}"
@inject HttpClient Http
@using BaiTapThucTapFrontend.Models

@if (model == null || model.ChiTiets == null)
{
    <div class="loading-message no-print">
        Đang tải dữ liệu phiếu nhập...
    </div>
}
else
{
    <div class="print-container">

        <!-- ================= HEADER ================= -->
        <div class="top-header">

            <!-- LEFT -->
            <div class="header-left">
                <p><b>Đơn vị :</b> .....................................</p>
                <p><b>Bộ phận :</b> .....................................</p>

                <div class="info-section mt-2">

                    <div class="info-row">
                        <div class="info-label">Ngày :</div>
                        <div class="info-value">
                            @model.Ngay_Nhap_Kho?.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Số Phiếu Nhập :</div>
                        <div class="info-value">
                            <b>@model.So_Phieu_Nhap_Kho</b>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Người Giao :</div>
                        <div class="info-value">
                            <b>@model.Ten_NCC</b>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Nhập Tại Kho :</div>
                        <div class="info-value">
                            <b>@model.Ten_Kho</b>
                        </div>
                    </div>

                </div>
            </div>

            <!-- CENTER -->
            <div class="header-center">
                <h1>PHIẾU NHẬP KHO</h1>

                <div class="mini-row">
                    <span><b>Nợ :</b> ....................</span>
                </div>

                <div class="mini-row">
                    <span><b>Có :</b> ....................</span>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="header-right">
                <h2>Mẫu Số : 01 - VT</h2>

                <p>
                    (Ban Hành Theo QĐ Số 15/2006/QĐ-BTC)
                </p>

                <p>
                    Ngày 20/03/2006 Của Bộ Trưởng BTC
                </p>
            </div>

        </div>

        <!-- ================= TABLE ================= -->
        <table class="table-print">

            <thead>

                <tr>
                    <th rowspan="2" style="width:60px">STT</th>

                    <th rowspan="2">
                        Tên nhãn hiệu, quy cách,
                        phẩm chất, vật tư...
                    </th>

                    <th rowspan="2" style="width:120px">
                        Mã Hàng
                    </th>

                    <th rowspan="2" style="width:100px">
                        Đơn Vị Tính
                    </th>

                    <th colspan="2" style="width:120px">
                        Số Lượng
                    </th>

                    <th rowspan="2" style="width:130px">
                        Đơn Giá
                    </th>

                    <th rowspan="2" style="width:150px">
                        Thành Tiền
                    </th>
                </tr>

                <tr>
                    <th>Kiện</th>
                    <th>Cái</th>
                </tr>

                <tr class="sub-header">
                    <td>A</td>
                    <td>B</td>
                    <td>C</td>
                    <td>D</td>
                    <td>1</td>
                    <td>2</td>
                    <td>3</td>
                    <td>4</td>
                </tr>

            </thead>

            <tbody>

                @{
                    int stt = 1;

                    foreach (var item in model.ChiTiets)
                    {
                        <tr>

                            <td class="text-center">
                                @(stt++)
                            </td>

                            <td class="text-left">
                                @item.Ten_San_Pham
                            </td>

                            <td class="text-center">
                                @item.Ma_San_Pham
                            </td>

                            <td class="text-center">
                                @item.Ten_Don_Vi_Tinh
                            </td>

                            <td class="text-center"></td>

                            <td class="text-right">
                                @item.SL_Nhap
                            </td>

                            <td class="text-right">
                                @item.Don_Gia_Nhap.ToString("N0") VND
                            </td>

                            <td class="text-right">
                                @((item.SL_Nhap * item.Don_Gia_Nhap).ToString("N0")) VND
                            </td>

                        </tr>
                    }
                }

            </tbody>

            <tfoot>

                <tr>

                    <td colspan="4" class="text-center">
                        <b>TỔNG</b>
                    </td>

                    <td></td>

                    <td class="text-right">
                        <b>
                            @model.ChiTiets.Sum(x => x.SL_Nhap).ToString("N0")
                        </b>
                    </td>

                    <td></td>

                    <td class="text-right">
                        <b>
                            @model.ChiTiets.Sum(x => x.SL_Nhap * x.Don_Gia_Nhap).ToString("N0") VND
                        </b>
                    </td>

                </tr>

            </tfoot>

        </table>

        <!-- ================= TOTAL ================= -->

        <div class="total-money">
            Tổng Số Tiền (Viết bằng chữ) :
            ..............................................................................
        </div>

        <div class="mt-2">
            <b>Số Chứng Từ Gốc Kèm Theo :</b>
            ........................................................
        </div>

        <!-- ================= DATE ================= -->

        <div class="date-print">
            Ngày ..... Tháng ..... Năm .....
        </div>

        <!-- ================= SIGNATURE ================= -->

        <div class="signature-section">

            <div class="signature-item">
                <div class="title">
                    Người Lập Phiếu
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>
            </div>

            <div class="signature-item">
                <div class="title">
                    Người Giao Hàng
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>
            </div>

            <div class="signature-item">
                <div class="title">
                    Thủ Kho
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>
            </div>

            <div class="signature-item">
                <div class="title">
                    Kế Toán Trưởng
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>
            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private NhapKhoDto? model;

    private string msg = "";

    List<SanPhamDto> listSanPham = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            model = await Http
                .GetFromJsonAsync<NhapKhoDto>($"api/NhapKho/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        await LoadList();
    }

    private async Task LoadList()
    {
        try
        {
            listSanPham = await Http
                .GetFromJsonAsync<List<SanPhamDto>>("api/SanPham")
                ?? new();
        }
        catch
        {
            msg = "Lỗi khi lấy thông tin sản phẩm";
        }
    }
}