
@page "/bao-cao-chi-tiet-hang-nhap"

@using System.Net.Http.Json
@using BaiTapThucTapFrontend.Models
@using BaiTapThucTapFrontend.Services

@inject HttpClient Http
@inject AppState AppState

@rendermode InteractiveServer

<div class="container-fluid py-2">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <!-- HEADER -->

        <div class="card-header border-0 py-3 px-4 text-white"
             style="background:linear-gradient(135deg,#6f42c1,#8b5cf6)">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="mb-1 fw-bold">
                        <i class="bi bi-box-seam me-2"></i>
                        Báo Cáo Chi Tiết Hàng Nhập
                    </h6>

                </div>

            </div>
        </div>

        <!-- BODY -->

        <div class="card-body p-2">

            <!-- SEARCH -->

            <div class="row g-3 align-items-end mb-2">

                <div class="col-lg-3">

                    <label class="fw-semibold mb-2">
                        Từ ngày
                    </label>

                    <InputDate class="form-control shadow-sm"
                               @bind-Value="tuNgay" />

                </div>

                <div class="col-lg-3">

                    <label class="fw-semibold mb-2">
                        Đến ngày
                    </label>

                    <InputDate class="form-control shadow-sm"
                               @bind-Value="denNgay" />

                </div>

                <div class="col-lg-2">

                    <button class="btn text-white w-100 shadow-sm"
                            style="background:#6f42c1;height:38px"
                            @onclick="LoadBaoCao">

                        <i class="bi bi-search me-1"></i>
                        Tìm kiếm

                    </button>

                </div>

                <div class="col-lg-4 text-end">

                    <div class="bg-light rounded-3 p-3 border">

                        <div class="text-muted small">
                            Tổng trị giá nhập kho
                        </div>

                        <div class="fs-4 fw-bold text-danger">

                            @TongTriGia.ToString("N0") VND

                        </div>

                    </div>

                </div>

            </div>

            <!-- TABLE -->

            <div class="table-responsive table-scroll">
                <table class="table table-striped table-hover table-purple border">

               @*  <table class="table table-hover align-middle mb-0"> *@

                    <thead>

                        <tr>

                            <th class="text-center py-3">
                                Ngày nhập
                            </th>

                            <th class="">
                                Số phiếu
                            </th>

                            <th class="">
                                NCC
                            </th>

                            <th class="text-center">
                                Mã SP
                            </th>

                            <th>
                                Tên sản phẩm
                            </th>

                            <th class="text-center">
                                SL nhập
                            </th>

                            <th class="text-end">
                                Đơn giá
                            </th>

                            <th class="text-end">
                                Trị giá
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (dsBaoCao.Count == 0)
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5 text-muted">

                                    <div class="d-flex flex-column align-items-center">

                                        <i class="bi bi-inbox fs-1 mb-3"></i>

                                        <span>
                                            Không có dữ liệu báo cáo
                                        </span>

                                    </div>

                                </td>

                            </tr>
                        }

                        @foreach (var item in dsBaoCao)
                        {
                            <tr>

                                <td class="text-center">

                                    @item.Ngay_Nhap.ToString("dd/MM/yyyy")

                                </td>

                                <td class="fw-semibold">

                                    @item.So_Phieu_Nhap_Kho

                                </td>

                                <td>

                                    @item.Ten_NCC

                                </td>

                                <td class="text-center">

                                    <span class="badge bg-light text-dark border px-3 py-2">

                                        @item.Ma_San_Pham

                                    </span>

                                </td>

                                <td>

                                    @item.Ten_San_Pham

                                </td>

                                <td class="text-center fw-semibold">

                                    @item.SL_Nhap

                                </td>

                                <td class="text-end text-primary fw-semibold">

                                    @item.Don_Gia_Nhap.ToString("N0") VND

                                </td>

                                <td class="text-end">

                                    <span class="fw-bold text-success">

                                        @((item.SL_Nhap * item.Don_Gia_Nhap).ToString("N0")) VND

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                    @if (dsBaoCao.Count > 0)
                    {
                        <tfoot>

                            <tr style="background:#faf5ff">

                                <th colspan="7"
                                    class="text-end py-3 fs-6">

                                    Tổng cộng

                                </th>

                                <th class="text-end text-danger fs-5">

                                    @TongTriGia.ToString("N0") VND

                                </th>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>

        </div>

    </div>

</div>

@code {

    private List<BaoCaoNhapKhoDto> dsBaoCao = new();

    private DateTime tuNgay = DateTime.Today.AddDays(-7);

    private DateTime denNgay = DateTime.Today;

    private decimal TongTriGia =>
        dsBaoCao.Sum(x => x.SL_Nhap * x.Don_Gia_Nhap);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaoCao();
    }

    private async Task LoadBaoCao()
    {
        try
        {
            dsBaoCao = await Http.GetFromJsonAsync<List<BaoCaoNhapKhoDto>>
            (
                $"api/NhapKho/bao-cao-chi-tiet-hang-nhap?startDate={tuNgay:yyyy-MM-dd}&endDate={denNgay:yyyy-MM-dd}&userKhoId={AppState.Kho_ID}&isAdmin={AppState.isAdmin}"
            );
        }
        catch
        {
            dsBaoCao = new();
        }
    }
}
```
