@page "/bao-cao-xuat-nhap-ton"

@using System.Net.Http.Json
@using BaiTapThucTapFrontend.Models
@using BaiTapThucTapFrontend.Services
@inject AppState AppState

@inject HttpClient Http

@rendermode InteractiveServer

<div class="container-fluid py-4">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <!-- HEADER -->

        <div class="card-header border-0 py-3 px-4 text-white"
             style="background:linear-gradient(135deg,#6f42c1,#8b5cf6)">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h6 class="mb-1 fw-bold">
                        <i class="bi bi-clipboard-data me-2"></i>
                        Báo Cáo Xuất Nhập Tồn
                    </h6>

                </div>

            </div>

        </div>

        <!-- BODY -->

        <div class="card-body p-4">

            <!-- SEARCH -->

            <div class="row g-3 align-items-end mb-4">

                <div class="col-lg-3">

                    <label class="fw-semibold mb-2">
                        Từ ngày
                    </label>

                    <InputDate class="form-control shadow-sm"
                               @bind-Value="tuNgay" />

                </div>

                <div class="col-lg-3">

                    <label class="fw-semibold mb-2">
                        Đến ngày
                    </label>

                    <InputDate class="form-control shadow-sm"
                               @bind-Value="denNgay" />

                </div>

                <div class="col-lg-2">

                    <button class="btn text-white w-100 shadow-sm"
                            style="background:#6f42c1;height:38px"
                            @onclick="LoadBaoCao">

                        <i class="bi bi-search me-1"></i>
                        Tìm kiếm

                    </button>

                </div>

                <div class="col-lg-4 text-end">

                    <div class="bg-light rounded-3 p-3 border">

                        <div class="text-muted small">
                            Tổng tồn cuối kỳ
                        </div>

                        <div class="fs-4 fw-bold text-danger">

                            @TongTonCuoiKy

                        </div>

                    </div>

                </div>

            </div>

            <!-- TABLE -->

            <div class="table-responsive rounded-3 border">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr style="background:#f3e8ff">

                            <th class="text-center py-3">
                                Mã SP
                            </th>

                            <th>
                                Tên sản phẩm
                            </th>

                            <th class="text-center">
                                SL Đầu Kỳ
                            </th>

                            <th class="text-center">
                                SL Nhập
                            </th>

                            <th class="text-center">
                                SL Xuất
                            </th>

                            <th class="text-center">
                                SL Cuối Kỳ
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (dsBaoCao.Count == 0)
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    <div class="d-flex flex-column align-items-center">

                                        <i class="bi bi-inbox fs-1 mb-3"></i>

                                        <span>
                                            Không có dữ liệu báo cáo
                                        </span>

                                    </div>

                                </td>

                            </tr>
                        }

                        @foreach (var item in dsBaoCao)
                        {
                            <tr>

                                <td class="text-center">

                                    <span class="badge bg-light text-dark border px-3 py-2">

                                        @item.Ma_San_Pham

                                    </span>

                                </td>

                                <td class="fw-semibold">

                                    @item.Ten_San_Pham

                                </td>

                                <td class="text-center text-primary fw-bold">

                                    @item.SL_Dau_Ky

                                </td>

                                <td class="text-center text-success fw-bold">

                                    @item.SL_Nhap

                                </td>

                                <td class="text-center text-danger fw-bold">

                                    @item.SL_Xuat

                                </td>

                                <td class="text-center">

                                    <span class="badge rounded-pill px-3 py-2 fs-6"  style="background:#6f42c1">

                                        @item.SL_Cuoi_Ky

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                    @if (dsBaoCao.Count > 0)
                    {
                        <tfoot>

                            <tr style="background:#faf5ff">

                                <th colspan="5"
                                    class="text-end py-3 fs-6">

                                    Tổng tồn cuối kỳ

                                </th>

                                <th class="text-center text-danger fs-5">

                                    @TongTonCuoiKy

                                </th>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>

        </div>

    </div>

</div>

@code {

    private List<BaoCaoXuatNhapTonDto> dsBaoCao = new();

    private DateTime tuNgay = DateTime.Today.AddDays(-7);

    private DateTime denNgay = DateTime.Today;

    private int TongTonCuoiKy =>
        dsBaoCao.Sum(x => x.SL_Cuoi_Ky);

    protected override async Task OnInitializedAsync()
    {
        await LoadBaoCao();
    }

    private async Task LoadBaoCao()
    {
        try
        {
            dsBaoCao = await Http.GetFromJsonAsync<List<BaoCaoXuatNhapTonDto>>
            (
                $"api/XuatNhapTon/bao-cao-xuat-nhap-ton?startDate={tuNgay:yyyy-MM-dd}&endDate={denNgay:yyyy-MM-dd}&userKhoId={AppState.Kho_ID}&isAdmin={AppState.isAdmin}"
            );
        }
        catch
        {
            dsBaoCao = new();
        }
    }
}