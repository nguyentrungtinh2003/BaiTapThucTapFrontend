@page "/xuat-kho-print/{Id:int}"

@inject HttpClient Http
@using BaiTapThucTapFrontend.Models

@if (model == null)
{
    <div class="loading-message no-print">
        <tr>
            <td colspan="7" class="text-center py-5">

                <div class="d-flex flex-column align-items-center">

                    <div class="spinner-border mb-3"
                         role="status"
                         style="
                    width: 3rem;
                    height: 3rem;
                    color:#6f42c1;
                     ">
                    </div>

                    <span class="fw-semibold"
                          style="color:#6f42c1">
                        Đang tải dữ liệu...
                    </span>

                </div>

            </td>
        </tr>
    </div>
}
else
{
    <div class="print-container">

        <!-- ================= HEADER ================= -->

        <div class="top-header">

            <!-- LEFT -->
            <div class="header-left">

                <p><b>Đơn vị :</b> .....................................</p>

                <p><b>Bộ phận :</b> .....................................</p>

                <div class="info-section mt-2">

                    <div class="info-row">
                        <div class="info-label">
                            Ngày Xuất :
                        </div>

                        <div class="info-value">
                            @model.Ngay_Xuat_Kho?.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">
                            Số Phiếu :
                        </div>

                        <div class="info-value">
                            <b>@model.So_Phieu_Xuat_Kho</b>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">
                            Kho Xuất :
                        </div>

                        <div class="info-value">
                            <b>@model.Ten_Kho</b>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">
                            Ghi Chú :
                        </div>

                        <div class="info-value">
                            @model.Ghi_Chu
                        </div>
                    </div>

                </div>

            </div>

            <!-- CENTER -->
            <div class="header-center">

                <h1>PHIẾU XUẤT KHO</h1>

                <div class="mini-row">
                    <span><b>Nợ :</b> ....................</span>
                </div>

                <div class="mini-row">
                    <span><b>Có :</b> ....................</span>
                </div>

            </div>

            <!-- RIGHT -->
            <div class="header-right">

                <h2>Mẫu Số : 02 - VT</h2>

                <p>
                    (Ban Hành Theo QĐ Số 15/2006/QĐ-BTC)
                </p>

                <p>
                    Ngày 20/03/2006 Của Bộ Trưởng BTC
                </p>

            </div>

        </div>

        <!-- ================= INFO ================= -->

        <div class="info-section">

            <div class="info-row">
                <div class="info-label">
                    Lệnh Giao Hàng :
                </div>

                <div class="info-value">
                    ..........................................................
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    Cửa Hàng :
                </div>

                <div class="info-value">
                    ..........................................................
                </div>
            </div>

        </div>

        <!-- ================= TABLE ================= -->

        <table class="table-print">

            <thead>

                <tr>

                    <th style="width:60px">
                        STT
                    </th>

                    <th style="width:130px">
                        Mã Hàng
                    </th>

                    <th>
                        Tên Hàng
                    </th>

                    <th style="width:90px">
                        PO
                    </th>

                    <th style="width:130px">
                        Số Chỉ Lệnh
                    </th>

                    <th style="width:70px">
                        SL
                    </th>

                    <th style="width:90px">
                        ĐVT
                    </th>

                    <th style="width:110px">
                        Kiểm Kê
                    </th>

                    <th style="width:120px">
                        Ghi Chú
                    </th>

                </tr>

            </thead>

            <tbody>

                @{
                    int stt = 1;
                }

                @foreach (var item in model.ChiTiets)
                {
                    <tr>

                        <td class="text-center">
                            @(stt++.ToString("D2"))
                        </td>

                        <td class="text-left">
                            @item.Ma_San_Pham
                        </td>

                        <td class="text-left">
                            @item.Ten_San_Pham
                        </td>

                        <td></td>

                        <td></td>

                        <td class="text-right">
                            @item.SL_Xuat
                        </td>

                        <td class="text-center">
                            @item.Ten_Don_Vi_tinh
                        </td>

                        <td></td>

                        <td></td>

                    </tr>
                }

            </tbody>

            <tfoot>

                <tr>

                    <td colspan="5" class="text-center">
                        <b>TỔNG</b>
                    </td>

                    <td class="text-right">
                        <b>
                            @model.ChiTiets.Sum(x => x.SL_Xuat)
                        </b>
                    </td>

                    <td colspan="3"></td>

                </tr>

            </tfoot>

        </table>

        <!-- ================= TOTAL ================= -->

        <div class="total-money">

            Tổng số lượng thực xuất :

            <b>
                @model.ChiTiets.Sum(x => x.SL_Xuat)
            </b>

        </div>

        <div class="mt-2">
            <b>Tổng số lượng bằng chữ :</b>
            ..........................................................................
        </div>

        <!-- ================= DESCRIPTION ================= -->

        <div class="mt-3">

            <b>Mô tả khác biệt :</b>

            <div class="description-box"></div>

        </div>

        <!-- ================= DATE ================= -->

        <div class="date-print">
            Ngày ..... Tháng ..... Năm .....
        </div>

        <!-- ================= SIGNATURE ================= -->

        <div class="signature-section">

            <div class="signature-item">

                <div class="title">
                    Người Lập Phiếu
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>

            </div>

            <div class="signature-item">

                <div class="title">
                    Người Nhận Hàng
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>

            </div>

            <div class="signature-item">

                <div class="title">
                    Điều Phối
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>

            </div>

            <div class="signature-item">

                <div class="title">
                    Giám Đốc
                </div>

                <div class="note">
                    (Ký, họ tên)
                </div>

                <div class="signature-space"></div>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private XuatKhoDto? model;

    private string msg = "";

    List<SanPhamDto> listSanPham = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            model = await Http
                .GetFromJsonAsync<XuatKhoDto>($"api/XuatKho/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Lỗi: " + ex.Message);
        }

        await LoadList();
    }

    private async Task LoadList()
    {
        try
        {
            listSanPham = await Http
                .GetFromJsonAsync<List<SanPhamDto>>("api/SanPham")
                ?? new();
        }
        catch
        {
            msg = "Lỗi khi lấy thông tin sản phẩm";
        }
    }
}