    @if (showForm)
    {
        <div class="overlay">
            <div class="form-popup card shadow">
                <div class="card-header text-white d-flex justify-content-between align-items-center"
                     style="background:#6f42c1">

                    <h5 class="mb-0">
                        @(isEdit ? "Cập nhật" : "Thêm mới") tài khoản
                    </h5>

                    <button class="btn btn-sm btn-danger border-0 text-white shadow-none" @onclick="() => CloseForm()">

                        <i class="bi bi-x-lg fs-6"></i>

                    </button>

                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label>Mã đăng nhập</label>
                        <input class="form-control" @bind="model.Ma_Dang_Nhap" placeholder="Nhập mã nhân viên ..." />
                    </div>

                    <div class="mb-3">
                        <label>Kho</label>
                        <select class="form-select" @bind="model.Kho_ID">

                                <option value="">-- chọn kho --</option>

                                @foreach (var kho in listKho)
                                {
                                    <option value="@kho.Id">@kho.Ten_Kho</option>
                                }           

                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        @*  <button class="btn btn-danger"
                    @onclick="() => {showForm = false; isEdit = false;}">
                    Hủy
                    </button> *@

                        <button class="btn text-white"
                                style="background:#6f42c1"
                                @onclick="HandleSave">
                            Lưu
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(msg))
                    {
                        <div class="alert mt-2 shadow-sm border-0 text-dark rounded-3"
                             style="background:#ede9fe;">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            @msg

                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* Bảng hiển thị *@
    <div class="table-responsive">
        <table class="table table-striped table-hover table-purple border">
            <thead class="">
                <tr>

                    <th>STT</th>
                    <th>Mã đăng nhập</th>
                    <th>Kho</th>
                    <th class="text-center" width="180">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (listData == null)
                {
                    <tr><td colspan="4" class="text-center">Đang tải dữ liệu từ API...</td></tr>
                }
                else if (listData.Count == 0)
                {
                    <tr><td colspan="4" class="text-center">Chưa có dữ liệu nào.</td></tr>
                }
                else
                {
                    @code {
                    int i = 1;
                }
                    foreach (var item in listData)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.Ma_Dang_Nhap</td>
                            <td>@item.Ten_Kho</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                   @*  <button class="btn btn-sm btn-warning rounded-circle text-white shadow-sm" @onclick="() => LoadEdit(item)"> <i class="bi bi-pencil-square"></i></button> *@
                                    <button class="btn btn-sm btn-danger rounded-circle text-white shadow-sm" @onclick="() => Delete(item.Ma_Dang_Nhap,item.Kho_ID)"> <i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {

    private List<KhoUserDto>? listData;
    private List<KhoDto>? listKho;

    // List<DonViTinhDto> listData = new List<DonViTinhDto> {
    //     new DonViTinhDto { Id = 1, Ten_Don_Vi_Tinh = "Kg", Ghi_Chu = "Note" },
    //     new DonViTinhDto { Id = 2, Ten_Don_Vi_Tinh = "Cai", Ghi_Chu = "Note" },
    //     new DonViTinhDto { Id = 3, Ten_Don_Vi_Tinh = "Thung", Ghi_Chu = "Note" },
    //     new DonViTinhDto { Id = 4, Ten_Don_Vi_Tinh = "Bo", Ghi_Chu = "Note" },
    //     new DonViTinhDto { Id = 5, Ten_Don_Vi_Tinh = "Mieng", Ghi_Chu = "Note" }, };

    private KhoUserDto model = new();
    private string msg = "";
    private bool isEdit = false;
    private bool showForm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
    }

    private async Task LoadList()
    {
        try
        {
            listData = await Http.GetFromJsonAsync<List<KhoUserDto>>("api/KhoUser");
            listKho = await Http.GetFromJsonAsync<List<KhoDto>>("api/Kho");
        }
        catch
        {
            msg = "Lỗi khi lấy dữ liệu tài khoản hoặc kho";
            listData = new List<KhoUserDto>();
        }
    }

    private async Task CloseForm()
    {
        showForm = false;
        model = new();
        isEdit = false;
        msg = "";

        await LoadList();
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrEmpty(model.Ma_Dang_Nhap))
        {
            msg = "Vui lòng nhập mã đăng nhập!";
            return;
        }

        if(model.Kho_ID <= 0)
        {
            msg = "Kho không được rỗng";
            return;
        }

       
            try
            {
                var res = await Http.PostAsJsonAsync("api/KhoUser", model);

                if (res.IsSuccessStatusCode)
                {
                    msg = "Thêm mới thành công!";
                    showForm = false;
                    model = new();
                    isEdit = false;
                    await LoadList();
                }
                else
                {
                    var error = await res.Content.ReadAsStringAsync();
                    msg = error;
                }
            }
            catch
            {
                msg = "Lỗi khi thêm tài khoản";
            }
        
    }

    // private void LoadEdit(KhoUserDto item)
    // {
    //     model = new KhoUserDto { Ma_Dang_Nhap = item.Ma_Dang_Nhap, Kho_ID = item.Kho_ID, Ten_Kho = item.Ten_Kho};
    //     isEdit = true;
    //     showForm = true;
    //     // msg = "Đang ở chế độ chỉnh sửa"
    // }

    private async Task Delete(string Ma_Dang_Nhap,int Kho_ID)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn xóa tài khoản này?");
        if (confirm)
        {
            try
            {
                var res = await Http.DeleteAsync($"api/KhoUser/{Ma_Dang_Nhap}/{Kho_ID}");
                if (res.IsSuccessStatusCode)
                {
                    msg = "Xoá thành công!";
                    model = new();
                    isEdit = false;
                    await LoadList();
                }
                else
                {
                    var error = await res.Content.ReadAsStringAsync();
                    msg = error;
                }
            }
            catch
            {
                msg = "Lỗi khi xoá tài khoản";
            }
        }
    }
}